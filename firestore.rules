rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function adm(){ return request.auth.token.email == 'seuemail@exemplo.com'; }
    match /users/{u}  { allow read: if request.auth!=null; allow create: if request.auth.uid==u && request.resource.data.balance==0;
      allow update: if adm() || (request.auth.uid==u && request.resource.data.balance <= resource.data.balance); }
    match /teams/{t}  { allow read: if true; allow write: if adm(); }
    match /config/{c} { allow read: if true; allow write: if adm(); }
    match /bets/{b}   { allow read: if request.auth!=null; allow create: if request.auth.uid==request.resource.data.uid; allow update: if adm(); }
  }
}
